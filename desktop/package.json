{
  "name": "grepopilot-desktop",
  "version": "0.2.5",
  "description": "GrepoPilot Desktop: central compartilhada de movimentos, versão dinâmica e atualizações do Desktop",
  "main": "src/main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/engine-hooks.js && node --check src/renderer.js && node --test tests/*.test.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.grepopilot.desktop",
    "productName": "GrepoPilot Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "GrepoPilot-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jugo26",
        "repo": "automatic-enigma",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
